{
  // Follows docs/documentation-style-guide.md: prose wraps at 80 columns and
  // code at 120; tables and headings are not wrapped.
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    // Sibling sections of different parents may share a heading.
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    // Explicit anchors for evidence and reference identifiers.
    "MD033": { "allowed_elements": ["a", "br"] },
    "MD049": { "style": "underscore" }
  },
  // Evidence is preserved byte for byte and is never linted or formatted.
  "ignores": ["evidence/**", "**/.venv/**", "**/.uv-cache/**", "**/.uv-tools/**"]
}
